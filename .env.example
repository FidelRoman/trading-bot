# Credenciales FXCM — copiar a .env y completar. NUNCA subir .env a git.
# También se pueden introducir desde el panel (Ajustes → Cuenta de ejecución),
# que valida con un login real y escribe aquí.
FXCM_USER=
FXCM_PASS=
# "Demo" para cuenta de práctica. Solo poner "Real" cuando la estrategia esté validada.
FXCM_CONNECTION=Demo
FXCM_URL=http://www.fxcorporate.com/Hosts.jsp

# Obligatorio: protege /api/* y /ws. El backend falla cerrado si falta.
# Generar con: openssl rand -hex 32
BOT_API_TOKEN=

# Solo hace falta para `npm run dev`, que sirve el frontend en otro puerto.
# En producción la interfaz la sirve el propio backend: mismo origen, sin CORS.
BOT_ALLOWED_ORIGINS=http://localhost:3000

# Riesgo (fracciones sobre equity)
RISK_PER_TRADE=0.005
DAILY_LOSS_LIMIT=0.03
MAX_TRADES_PER_DAY=4
MAX_SPREAD_PIPS=1.5
