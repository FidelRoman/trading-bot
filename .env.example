# Credenciales FXCM — copiar a .env y completar. NUNCA subir .env a git.
FXCM_USER=
FXCM_PASS=
# "Demo" para cuenta de práctica. Solo poner "Real" cuando la estrategia esté validada.
FXCM_CONNECTION=Demo
FXCM_URL=http://www.fxcorporate.com/Hosts.jsp

# Secretos separados para el ejecutor de GitHub Actions. No subirlos al repo ni
# configurarlos en Vercel: el workflow es el único proceso que los consume.
FXCM_USER_DEMO=
FXCM_PASS_DEMO=
FXCM_USER_REAL=
FXCM_PASS_REAL=

# Obligatorio al exponer el backend. Generar con: openssl rand -hex 32
BOT_API_TOKEN=
# Origen exacto de Vercel; varios valores se separan con coma. No usar "*".
BOT_ALLOWED_ORIGINS=http://localhost:3000

# Runtime: GitHub Actions ejecuta un tick programado y Firestore no tiene billing.
EXECUTION_MODE=scheduled
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION_PREFIX=tradingbot
# JSON completo de una cuenta de servicio; configurarlo como secret, no commitearlo.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Riesgo (fracciones sobre equity)
RISK_PER_TRADE=0.005
DAILY_LOSS_LIMIT=0.03
MAX_TRADES_PER_DAY=4
MAX_SPREAD_PIPS=1.5
