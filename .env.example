# Credenciales FXCM — copiar a .env y completar. NUNCA subir .env a git.
# También se pueden introducir desde el panel (Ajustes → Cuenta de ejecución),
# que valida con un login real y escribe aquí.
# Credenciales por cuenta (respaldadas por el par genérico):
FXCM_USER_DEMO=
FXCM_PASS_DEMO=
FXCM_USER_REAL=
FXCM_PASS_REAL=
FXCM_USER=
FXCM_PASS=
# "Demo" para cuenta de práctica. "Real" queda habilitado bajo responsabilidad
# explícita del operador, incluso si el modelo o estrategia no están validados.
# Con FXCM_CONNECTION=Real el bot arranca pausado a propósito y puede iniciarse
# desde el panel. MOCK=1 fuerza el modo simulado.
FXCM_CONNECTION=Demo
FXCM_URL=https://www.fxcorporate.com/Hosts.jsp

# El backend NO autentica /api/* ni /ws: quien alcanza el puerto puede consultar
# la cuenta y enviar órdenes. Es deliberado para uso local, y se apoya en que el
# puerto solo sea alcanzable desde localhost y desde tu tailnet (ver README).
# BOT_API_TOKEN ya no se lee; se mantiene comentado por si se restaura la auth.
#BOT_API_TOKEN=

# Solo hace falta para `npm run dev`, que sirve el frontend en otro puerto.
# En producción la interfaz la sirve el propio backend: mismo origen, sin CORS.
BOT_ALLOWED_ORIGINS=http://localhost:3000

# Riesgo (fracciones sobre equity)
RISK_PER_TRADE=0.005
DAILY_LOSS_LIMIT=0.03
MAX_TRADES_PER_DAY=4
MAX_SPREAD_PIPS=1.5
# Puerta de spread relativa, en puntos básicos del precio medio. Es la que sirve
# fuera de divisas: 1,5 pips absolutos vetarían el 100% del oro y de las acciones.
MAX_SPREAD_BPS=2.0
# Tope técnico para una orden manual enviada por API. No valida la estrategia ni
# impide operar en Real; evita errores de teclado o clientes fuera de la UI.
MAX_MANUAL_LOTS=100
